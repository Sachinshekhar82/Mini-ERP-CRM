{
  "info": {
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Complete Postman collection for testing Mini ERP + CRM backend REST APIs including Auth, Customers CRM, Products & Inventory, Stock Movement Logs, and Sales Challans.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin Role)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Login (Sales Role)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@company.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me" }
          }
        }
      ]
    },
    {
      "name": "2. Customer CRM",
      "item": [
        {
          "name": "Get Customers (List with search & filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&search=&status=&type="
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Sethi\",\n  \"mobile\": \"+91 9822001122\",\n  \"email\": \"vikram@sethitraders.com\",\n  \"businessName\": \"Sethi Traders & Supplies\",\n  \"gstNumber\": \"27AAACS1234E1Z8\",\n  \"type\": \"DISTRIBUTOR\",\n  \"address\": \"77 Ring Road, Pune, Maharashtra 411001\",\n  \"status\": \"ACTIVE\",\n  \"followUpDate\": \"2026-08-20\",\n  \"notes\": \"Key wholesale buyer for Western Maharashtra.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers" }
          }
        },
        {
          "name": "Add Follow-up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Scheduled call with purchase manager for Q3 rate contract renewal.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers/CUSTOMER_ID_HERE/notes" }
          }
        }
      ]
    },
    {
      "name": "3. Product & Inventory",
      "item": [
        {
          "name": "Get Products (List & Low Stock Alert Filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/products?lowStock=false" }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Heavy Duty Cordless Angle Grinder\",\n  \"sku\": \"SKU-GRND-20V\",\n  \"category\": \"Power Tools\",\n  \"unitPrice\": 4250.00,\n  \"currentStock\": 30,\n  \"minStockAlert\": 8,\n  \"location\": \"Rack C-02, Warehouse 1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products" }
          }
        }
      ]
    },
    {
      "name": "4. Stock Movements",
      "item": [
        {
          "name": "Get Stock Movement Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/stock/logs" }
          }
        },
        {
          "name": "Adjust Stock Manually (IN / OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PRODUCT_ID_HERE\",\n  \"quantity\": 10,\n  \"movementType\": \"IN\",\n  \"reason\": \"Received Purchase Order #PO-9002\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/stock/adjust" }
          }
        }
      ]
    },
    {
      "name": "5. Sales Challans & PDF Invoices",
      "item": [
        {
          "name": "Get Sales Challans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/challans" }
          }
        },
        {
          "name": "Generate Sales Challan (Snapshot Protection)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID_HERE\",\n  \"status\": \"CONFIRMED\",\n  \"notes\": \"Express shipment. Invoice attached.\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/challans" }
          }
        },
        {
          "name": "Download PDF Invoice",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/challans/CHALLAN_ID_HERE/pdf" }
          }
        }
      ]
    }
  ]
}
