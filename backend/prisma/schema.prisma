datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SALES") // ADMIN, OPERATIONS, SALES, WAREHOUSE, ACCOUNTS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdFollowUps      CustomerFollowUp[]
  createdStockMovements StockMovement[]
  createdChallans       SalesChallan[]
  assignedWorkOrders    WorkOrder[]
  createdTransfers      InternalTransfer[]
  createdOrders         CustomerOrder[]

  @@index([email])
  @@index([role])
}

model Customer {
  id           String   @id @default(uuid())
  customerName String
  mobile       String
  email        String
  businessName String
  gstNumber    String?
  customerType String   @default("RETAIL") // RETAIL, WHOLESALE, DISTRIBUTOR
  address      String
  status       String   @default("LEAD") // LEAD, ACTIVE, INACTIVE
  followUpDate String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  followUps CustomerFollowUp[]
  challans  SalesChallan[]

  @@index([mobile])
  @@index([email])
  @@index([gstNumber])
  @@index([status])
  @@index([customerType])
}

model CustomerFollowUp {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdById])
}

model Product {
  id                String   @id @default(uuid())
  productName       String
  sku               String   @unique
  category          String
  unitPrice         Float
  currentStock      Int
  minimumStock      Int      @default(5)
  warehouseLocation String
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockMovements StockMovement[]
  challanItems   SalesChallanItem[]

  @@index([sku])
  @@index([category])
  @@index([productName])
}

model StockMovement {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityChanged Int
  movementType    String   // IN, OUT
  reason          String
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
}

model SalesChallan {
  id            String   @id @default(uuid())
  challanNumber String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalQuantity Int      @default(0)
  totalAmount   Float    @default(0)
  status        String   @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  notes         String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items SalesChallanItem[]

  @@index([challanNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdById])
}

model SalesChallanItem {
  id                  String       @id @default(uuid())
  challanId           String
  challan             SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String
  product             Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Float
  quantity            Int
  totalPrice          Float

  @@index([challanId])
  @@index([productId])
}

// ============================================================================
// MANDATORY CASE STUDY MODULES (Inventory, Work Orders, Transfers, Reservations)
// ============================================================================

model InventoryItem {
  id           String   @id @default(uuid())
  itemName     String
  sku          String
  category     String
  location     String   // e.g. "Location A (Warehouse Main)", "Location B (Branch Depot)"
  batch        String   // Batch / Lot Number e.g. "BATCH-2026-01"
  physicalQty  Int      @default(0)
  reservedQty  Int      @default(0)
  availableQty Int      @default(0) // Physical - Reserved
  unitPrice    Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workOrders        WorkOrder[]
  internalTransfers InternalTransfer[]
  customerOrders    CustomerOrder[]

  @@unique([sku, location, batch])
  @@index([sku])
  @@index([location])
  @@index([category])
}

model WorkOrder {
  id              String        @id @default(uuid())
  workOrderNumber String        @unique // e.g. "WO-2026-0001"
  location        String
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  requiredQty     Int
  shortageQty     Int           @default(0) // Auto-calculated shortage
  assignedUserId  String
  assignedUser    User          @relation(fields: [assignedUserId], references: [id])
  status          String        @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, COMPLETED
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workOrderNumber])
  @@index([location])
  @@index([status])
  @@index([assignedUserId])
}

model InternalTransfer {
  id                  String        @id @default(uuid())
  transferNumber      String        @unique // e.g. "TR-2026-0001"
  sourceLocation      String
  destinationLocation String
  inventoryItemId     String
  inventoryItem       InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity            Int
  status              String        @default("REQUESTED") // REQUESTED, DISPATCHED, RECEIVED
  dispatchedAt        DateTime?
  receivedAt          DateTime?
  createdById         String
  createdBy           User          @relation(fields: [createdById], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([transferNumber])
  @@index([sourceLocation])
  @@index([destinationLocation])
  @@index([status])
}

model CustomerOrder {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // e.g. "ORD-2026-0001"
  customerName    String
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int
  status          String        @default("PENDING") // PENDING, RESERVED, COMPLETED, CANCELLED
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([createdById])
}
