datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SALES") // ADMIN, SALES, WAREHOUSE, ACCOUNTS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdFollowUps    CustomerFollowUp[]
  createdStockMovements StockMovement[]
  createdChallans     SalesChallan[]

  @@index([email])
  @@index([role])
}

model Customer {
  id           String   @id @default(uuid())
  customerName String
  mobile       String
  email        String
  businessName String
  gstNumber    String?
  customerType String   @default("RETAIL") // RETAIL, WHOLESALE, DISTRIBUTOR
  address      String
  status       String   @default("LEAD") // LEAD, ACTIVE, INACTIVE
  followUpDate String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  followUps CustomerFollowUp[]
  challans  SalesChallan[]

  @@index([mobile])
  @@index([email])
  @@index([gstNumber])
  @@index([status])
  @@index([customerType])
}

model CustomerFollowUp {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdById])
}

model Product {
  id                String   @id @default(uuid())
  productName       String
  sku               String   @unique
  category          String
  unitPrice         Float
  currentStock      Int
  minimumStock      Int      @default(5)
  warehouseLocation String
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockMovements StockMovement[]
  challanItems   SalesChallanItem[]

  @@index([sku])
  @@index([category])
  @@index([productName])
}

model StockMovement {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityChanged Int
  movementType    String   // IN, OUT
  reason          String
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
}

model SalesChallan {
  id            String   @id @default(uuid())
  challanNumber String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  totalQuantity Int      @default(0)
  totalAmount   Float    @default(0)
  status        String   @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  notes         String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items SalesChallanItem[]

  @@index([challanNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdById])
}

model SalesChallanItem {
  id                  String       @id @default(uuid())
  challanId           String
  challan             SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId           String
  product             Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Float
  quantity            Int
  totalPrice          Float

  @@index([challanId])
  @@index([productId])
}
